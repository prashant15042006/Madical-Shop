# NOTE: Do NOT ignore pnpm-lock.yaml, pnpm-workspace.yaml, or the workspace
# package directories (lib/, scripts/, artifacts/, backend/). The frontend
# build depends on the @workspace/* packages in lib/, and pnpm needs the
# lockfile + workspace manifest to resolve them.
