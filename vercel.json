{
  "version": 2,
  "installCommand": "npm install -g pnpm@9 && pnpm install --prod=false",
  "buildCommand": "pnpm --filter @workspace/frontend run build",
  "outputDirectory": "frontend/static-build",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
